{
  "name": "novabuilder",
  "version": "1.0.0",
  "description": "AI Website Builder Platform",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "build:css": "npx tailwindcss -i ./input.css -o ./public/css/output.css --watch",
    "build:css:prod": "npx tailwindcss -i ./input.css -o ./public/css/output.css --minify",
    "seed:admin": "node scripts/seedAdmin.js"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "mongoose": "^8.5.0",
    "multer": "^1.4.5-lts.1",
    "sanitize-html": "^2.13.1",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "tailwindcss": "^3.4.10"
  }
}
