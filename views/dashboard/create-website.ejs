<!DOCTYPE html>
<html lang="en">
<head>
  <title>Create Website • NovaBuilder</title>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen">
  <%- include('../partials/navbar') %>
  <%- include('../partials/sidebar', { active: 'websites' }) %>

  <div class="lg:pl-64 flex justify-center">
  <main class="w-full max-w-2xl px-4 sm:px-6 pt-24 sm:pt-28 pb-16">

    <!-- Step indicator -->
    <div class="flex items-center justify-center gap-2 mb-10">
      <div id="dot1" class="w-2.5 h-2.5 rounded-full bg-primary"></div>
      <div class="w-8 h-px bg-white/10"></div>
      <div id="dot2" class="w-2.5 h-2.5 rounded-full bg-white/10"></div>
      <div class="w-8 h-px bg-white/10"></div>
      <div id="dot3" class="w-2.5 h-2.5 rounded-full bg-white/10"></div>
    </div>

    <!-- ═══════════ STEP A: DESCRIBE ═══════════ -->
    <div id="stepAsk">

      <div class="text-center mb-8">
        <span class="inline-block text-xs font-semibold tracking-wide text-secondary bg-secondary/10 border border-secondary/30 rounded-full px-4 py-1.5 mb-4">
          ✨ AI POWERED
        </span>
        <h1 class="text-2xl sm:text-3xl font-bold mb-2">What type of website do you want?</h1>
        <p class="text-muted text-sm sm:text-base">Describe it in one sentence — our AI figures out pages, content, colors, and backend features automatically.</p>
      </div>

      <div class="card-glass p-5 sm:p-6 mb-3">
        <label class="text-xs font-semibold text-muted uppercase tracking-wide mb-3 block">Your description</label>
        <textarea
          id="descriptionInput"
          rows="3"
          class="input-field resize-none text-base"
          placeholder="e.g. Create a modern portfolio website for a Java developer"
        ></textarea>

        <div class="flex items-center justify-between mt-2 mb-4">
          <span id="charCount" class="text-xs text-muted">0 characters</span>
          <span id="qualityHint" class="text-xs text-muted"></span>
        </div>

        <div id="backendPreview" class="hidden text-xs bg-secondary/10 border border-secondary/30 rounded-lg px-3 py-2 text-secondary mb-4"></div>

        <button id="generateBtn" class="btn-primary w-full py-3 text-base">✨ Generate Website</button>
      </div>

      <div id="wizardAlert" class="hidden mb-6 text-sm rounded-lg px-4 py-3"></div>

      <div>
        <p class="text-xs font-semibold text-muted uppercase tracking-wide mb-3 text-center">Or try an example</p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <button type="button" class="example-card card-glass p-4 text-left hover:border-primary/40 border border-transparent transition-colors"
                  data-text="Create a modern portfolio website for a Java developer">
            <span class="text-xl mb-1 block">💻</span>
            <p class="text-sm font-medium">Developer Portfolio</p>
            <p class="text-xs text-muted mt-0.5">Modern portfolio for a Java developer</p>
          </button>

          <button type="button" class="example-card card-glass p-4 text-left hover:border-primary/40 border border-transparent transition-colors"
                  data-text="Create a modern restaurant website with online booking and a menu page">
            <span class="text-xl mb-1 block">🍽️</span>
            <p class="text-sm font-medium">Restaurant</p>
            <p class="text-xs text-muted mt-0.5">With online table booking</p>
          </button>

          <button type="button" class="example-card card-glass p-4 text-left hover:border-primary/40 border border-transparent transition-colors"
                  data-text="Create a gym website with membership signup and class schedule">
            <span class="text-xl mb-1 block">🏋️</span>
            <p class="text-sm font-medium">Gym & Fitness</p>
            <p class="text-xs text-muted mt-0.5">With membership signup</p>
          </button>

          <button type="button" class="example-card card-glass p-4 text-left hover:border-primary/40 border border-transparent transition-colors"
                  data-text="Create a photography portfolio website with a gallery and contact form">
            <span class="text-xl mb-1 block">📸</span>
            <p class="text-sm font-medium">Photography Portfolio</p>
            <p class="text-xs text-muted mt-0.5">With gallery & contact form</p>
          </button>
        </div>
      </div>
    </div>

    <!-- ═══════════ STEP B: GENERATING ═══════════ -->
    <div id="stepGenerating" class="hidden text-center">
      <h2 class="text-2xl font-bold mb-6">✨ AI is building your website</h2>
      <div class="card-glass p-6 text-left max-w-sm mx-auto">
        <ul class="space-y-3 text-sm text-muted">
          <li id="genStep1" class="flex items-center gap-2">○ Understanding your idea</li>
          <li id="genStep2" class="flex items-center gap-2">○ Planning pages</li>
          <li id="genStep3" class="flex items-center gap-2">○ Creating content, colors &amp; typography</li>
          <li id="genStep4" class="flex items-center gap-2">○ Preparing your visual editor</li>
        </ul>
      </div>
    </div>

    <!-- ═══════════ STEP C: READY ═══════════ -->
    <div id="stepReady" class="hidden text-center">
      <p class="text-5xl mb-4">🎉</p>
      <h2 class="text-2xl font-bold mb-2">Your website is ready!</h2>
      <p class="text-muted">Opening the visual editor...</p>
    </div>

  </main>
  </div>

  <script>window.CSRF_TOKEN = "<%= csrfToken %>";</script>
  <script src="/js/main.js"></script>
  <script src="/js/create-website.js"></script>
</body>
</html>