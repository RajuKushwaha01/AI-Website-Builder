<!DOCTYPE html>
<html lang="en">
<head>
  <title>Analytics • NovaBuilder</title>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen">
  <%- include('../partials/navbar') %>
  <%- include('../partials/sidebar', { active: 'analytics' }) %>

  <div class="lg:pl-64 flex justify-center">
  <main class="w-full max-w-4xl px-4 sm:px-6 pt-24 sm:pt-28 pb-16">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold">Analytics</h1>
      <select id="websiteSelect" class="input-field sm:w-56">
        <% websites.forEach(w => { %>
          <option value="<%= w._id %>" <%= String(w._id) === String(selectedWebsite) ? 'selected' : '' %>><%= w.name %></option>
        <% }) %>
      </select>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-8">
      <div class="card-glass p-5"><p class="text-muted text-sm mb-1">Visitors (30d)</p><p class="text-2xl font-bold text-secondary"><%= totals.visitors.toLocaleString() %></p></div>
      <div class="card-glass p-5"><p class="text-muted text-sm mb-1">Page Views (30d)</p><p class="text-2xl font-bold text-accent"><%= totals.views.toLocaleString() %></p></div>
      <div class="card-glass p-5"><p class="text-muted text-sm mb-1">Sessions (30d)</p><p class="text-2xl font-bold text-success"><%= totals.sessions.toLocaleString() %></p></div>
    </div>

    <div class="card-glass p-5 mb-8">
      <h3 class="font-semibold mb-4">Traffic Trend (30 days)</h3>
      <canvas id="trendChart" height="80"></canvas>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div class="card-glass p-5">
        <h3 class="font-semibold mb-3">Popular Pages</h3>
        <% topPages.forEach(p => { %>
          <div class="flex justify-between text-sm py-1.5 border-b border-white/5"><span class="text-muted"><%= p.page || '/' %></span><span><%= p.count %></span></div>
        <% }) %>
        <% if (topPages.length === 0) { %><p class="text-muted text-sm">No data yet.</p><% } %>
      </div>

      <div class="card-glass p-5">
        <h3 class="font-semibold mb-3">Devices</h3>
        <% Object.entries(devices).forEach(([k, v]) => { %>
          <div class="flex justify-between text-sm py-1.5 border-b border-white/5"><span class="text-muted capitalize"><%= k %></span><span><%= v %></span></div>
        <% }) %>
        <% if (Object.keys(devices).length === 0) { %><p class="text-muted text-sm">No data yet.</p><% } %>
      </div>

      <div class="card-glass p-5">
        <h3 class="font-semibold mb-3">Browsers</h3>
        <% Object.entries(browsers).forEach(([k, v]) => { %>
          <div class="flex justify-between text-sm py-1.5 border-b border-white/5"><span class="text-muted"><%= k %></span><span><%= v %></span></div>
        <% }) %>
        <% if (Object.keys(browsers).length === 0) { %><p class="text-muted text-sm">No data yet.</p><% } %>
      </div>

      <div class="card-glass p-5">
        <h3 class="font-semibold mb-3">Referrers</h3>
        <% Object.entries(referrers).forEach(([k, v]) => { %>
          <div class="flex justify-between text-sm py-1.5 border-b border-white/5"><span class="text-muted capitalize"><%= k %></span><span><%= v %></span></div>
        <% }) %>
        <% if (Object.keys(referrers).length === 0) { %><p class="text-muted text-sm">No data yet.</p><% } %>
      </div>
    </div>

  </main>
  </div>

  <script>
    document.getElementById("websiteSelect").addEventListener("change", (e) => {
      window.location.href = `/dashboard/analytics?website=${e.target.value}`;
    });
  </script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
  <script>
    const records = <%- JSON.stringify(records.map(r => ({ date: r.date, views: r.views, visitors: r.visitors }))) %>;
    if (records.length > 0) {
      new Chart(document.getElementById("trendChart"), {
        type: "line",
        data: {
          labels: records.map(r => r.date.slice(5)),
          datasets: [
            { label: "Views", data: records.map(r => r.views), borderColor: "#00C2FF", backgroundColor: "transparent", tension: 0.3 },
            { label: "Visitors", data: records.map(r => r.visitors), borderColor: "#FF4ECD", backgroundColor: "transparent", tension: 0.3 }
          ]
        },
        options: {
          responsive: true,
          plugins: { legend: { labels: { color: "#94A3B8" } } },
          scales: {
            x: { ticks: { color: "#94A3B8" }, grid: { color: "rgba(255,255,255,0.05)" } },
            y: { ticks: { color: "#94A3B8" }, grid: { color: "rgba(255,255,255,0.05)" } }
          }
        }
      });
    } else {
      document.getElementById("trendChart").outerHTML = '<p class="text-muted text-sm text-center py-8">No traffic data yet — publish a website to start tracking.</p>';
    }
  </script>
  <script src="/js/main.js"></script>
</body>
</html>