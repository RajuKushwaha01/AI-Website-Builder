<!DOCTYPE html>
<html lang="en">
<head>
  <title>Admin • NovaBuilder</title>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen">
  <%- include('../partials/navbar', { user: admin }) %>
  <%- include('layout-sidebar', { active: 'dashboard' }) %>

  <main class="lg:ml-64 max-w-6xl mx-auto px-6 pt-28 pb-16">
    <h1 class="text-3xl font-bold mb-8">Admin Dashboard</h1>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 mb-10">
      <div class="card-glass p-4"><p class="text-muted text-xs mb-1">Users</p><p class="text-xl font-bold text-secondary"><%= stats.userCount %></p></div>
      <div class="card-glass p-4"><p class="text-muted text-xs mb-1">Websites</p><p class="text-xl font-bold text-accent"><%= stats.websiteCount %></p></div>
      <div class="card-glass p-4"><p class="text-muted text-xs mb-1">Published</p><p class="text-xl font-bold text-success"><%= stats.publishedCount %></p></div>
      <div class="card-glass p-4"><p class="text-muted text-xs mb-1">AI Requests</p><p class="text-xl font-bold text-primary"><%= stats.aiTotal %></p></div>
      <div class="card-glass p-4"><p class="text-muted text-xs mb-1">AI Failures</p><p class="text-xl font-bold text-red-400"><%= stats.aiFailed %></p></div>
      <div class="card-glass p-4"><p class="text-muted text-xs mb-1">Forms</p><p class="text-xl font-bold text-warning"><%= stats.formCount %></p></div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div class="card-glass p-5">
        <h3 class="font-semibold mb-3">Recent Users</h3>
        <% recentUsers.forEach(u => { %>
          <div class="flex justify-between text-sm py-1.5 border-b border-white/5">
            <span><%= u.name %></span><span class="text-muted"><%= u.email %></span>
          </div>
        <% }) %>
      </div>
      <div class="card-glass p-5">
        <h3 class="font-semibold mb-3">Recent Websites</h3>
        <% recentWebsites.forEach(w => { %>
          <div class="flex justify-between text-sm py-1.5 border-b border-white/5">
            <span><%= w.name %></span><span class="text-muted"><%= w.owner?.name %></span>
          </div>
        <% }) %>
      </div>
    </div>
  </main>

  <script src="/js/main.js"></script>
</body>
</html>