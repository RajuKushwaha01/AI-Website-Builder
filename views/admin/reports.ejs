<!DOCTYPE html>
<html lang="en">
<head>
  <title>Reports • Admin</title>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen">
  <%- include('../partials/navbar', { user: admin }) %>
  <%- include('layout-sidebar', { active: 'reports' }) %>

  <main class="lg:ml-64 max-w-4xl mx-auto px-6 pt-28 pb-16">
    <h1 class="text-3xl font-bold mb-8">Reports (Last 30 Days)</h1>

    <div class="grid grid-cols-2 gap-5 mb-8">
      <div class="card-glass p-5"><p class="text-muted text-sm mb-1">New Users</p><p class="text-2xl font-bold text-secondary"><%= newUsers30d %></p></div>
      <div class="card-glass p-5"><p class="text-muted text-sm mb-1">New Websites</p><p class="text-2xl font-bold text-accent"><%= newWebsites30d %></p></div>
    </div>

    <div class="card-glass p-5">
      <h3 class="font-semibold mb-3">Published Websites by Type</h3>
      <% publishedByType.forEach(t => { %>
        <div class="flex justify-between text-sm py-1.5 border-b border-white/5">
          <span class="text-muted"><%= t._id || 'Unspecified' %></span><span><%= t.count %></span>
        </div>
      <% }) %>
    </div>
  </main>

  <script src="/js/main.js"></script>
</body>
</html>