<!-- Wraps sidebar + main content so the content area is TRUE-centered
     within the remaining viewport space, not just mx-auto'd inside a margin. -->
<div class="flex min-h-screen">
  <%- include('sidebar', { active: typeof active !== 'undefined' ? active : '' }) %>

  <div class="flex-1 lg:pl-64 flex justify-center">
    <main class="w-full <%= typeof maxWidth !== 'undefined' ? maxWidth : 'max-w-5xl' %> px-4 sm:px-6 pt-24 sm:pt-28 pb-16">
      <%- body %>
    </main>
  </div>
</div>