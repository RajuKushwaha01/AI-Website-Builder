<!DOCTYPE html>
<html lang="en">
<head>
  <title>Forgot Password • NovaBuilder</title>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen flex items-center justify-center relative overflow-hidden">

  <div class="absolute -top-40 -left-40 w-96 h-96 bg-primary/30 rounded-full blur-3xl"></div>

  <div class="relative z-10 w-full max-w-md mx-4">
    <div class="card-glass p-8">
      <h1 class="text-2xl font-bold mb-1 text-center">Reset your password</h1>
      <p class="text-muted text-sm text-center mb-6">Enter your email and we'll send you a reset link.</p>

      <% if (error) { %>
        <div class="bg-red-500/10 border border-red-500/30 text-red-300 text-sm rounded-lg px-4 py-3 mb-4"><%= error %></div>
      <% } %>
      <% if (message) { %>
        <div class="bg-success/10 border border-success/30 text-success text-sm rounded-lg px-4 py-3 mb-4"><%= message %></div>
      <% } %>

      <form action="/forgot-password" method="POST" class="space-y-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="email" name="email" required class="input-field" placeholder="you@example.com" />
        <button type="submit" class="btn-primary w-full">Send Reset Link</button>
      </form>

      <p class="text-center text-sm text-muted mt-6">
        <a href="/login" class="text-secondary hover:underline">Back to login</a>
      </p>
    </div>
  </div>
</body>
</html>