<section class="text-center px-6 py-24" style="background:linear-gradient(135deg, <%= theme.primary %>22, <%= theme.secondary %>22)">
  <h1 class="text-4xl sm:text-5xl font-bold font-heading mb-4"><%= section.content.title %></h1>
  <p class="text-muted text-lg mb-8 max-w-xl mx-auto"><%= section.content.subtitle %></p>
  <button class="px-6 py-3 rounded-xl font-semibold text-white" style="background:<%= theme.primary %>"><%= section.content.buttonText %></button>
</section>