<section class="px-6 py-16 max-w-5xl mx-auto">
  <h2 class="text-3xl font-bold text-center mb-10"><%= section.content.heading || 'Pricing' %></h2>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
    <% (section.content.plans || [{name:'Basic'},{name:'Pro'},{name:'Premium'}]).forEach(plan => { %>
      <div class="card-glass p-6 text-center">
        <h3 class="font-semibold mb-2"><%= plan.name %></h3>
        <p class="text-2xl font-bold mb-4" style="color:<%= theme.secondary %>"><%= plan.price || '—' %></p>
        <button class="btn-glass w-full text-sm">Choose</button>
      </div>
    <% }) %>
  </div>
</section>