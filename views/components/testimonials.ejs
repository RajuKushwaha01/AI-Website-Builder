<section class="px-6 py-16 max-w-5xl mx-auto">
  <h2 class="text-3xl font-bold text-center mb-10"><%= section.content.heading %></h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <% (section.content.items || []).forEach(item => { %>
      <div class="card-glass p-6">
        <p class="text-muted italic mb-3">"<%= item.quote %>"</p>
        <p class="font-semibold text-sm">— <%= item.name %></p>
      </div>
    <% }) %>
  </div>
</section>