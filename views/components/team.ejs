<section class="px-6 py-16 max-w-5xl mx-auto">
  <h2 class="text-3xl font-bold text-center mb-10"><%= section.content.heading || 'Our Team' %></h2>
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
    <% (section.content.members || []).forEach(member => { %>
      <div>
        <div class="w-16 h-16 mx-auto rounded-full mb-2" style="background:<%= theme.primary %>"></div>
        <p class="font-semibold text-sm"><%= member.name %></p>
        <p class="text-muted text-xs"><%= member.role %></p>
      </div>
    <% }) %>
  </div>
</section>