<section class="px-6 py-16 max-w-lg mx-auto">
  <h2 class="text-3xl font-bold text-center mb-8"><%= section.content.heading || 'Book a Reservation' %></h2>
  <form class="site-booking-form space-y-4" data-slug="<%= website.slug %>">
    <input type="text" name="name" required class="input-field" placeholder="Full name" />
    <input type="email" name="email" required class="input-field" placeholder="Email" />
    <input type="tel" name="phone" class="input-field" placeholder="Phone (optional)" />
    <div class="grid grid-cols-2 gap-3">
      <input type="date" name="date" required class="input-field" />
      <input type="time" name="time" required class="input-field" />
    </div>
    <input type="number" name="partySize" min="1" class="input-field" placeholder="Party size" value="2" />
    <textarea name="notes" rows="2" class="input-field" placeholder="Special requests (optional)"></textarea>
    <button type="submit" class="btn-primary w-full">Request Reservation</button>
    <p class="booking-status text-sm text-center hidden"></p>
  </form>
</section>

<script>
  document.querySelectorAll(".site-booking-form").forEach((form) => {
    if (form.dataset.bound) return;
    form.dataset.bound = "true";
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const status = form.querySelector(".booking-status");
      const data = Object.fromEntries(new FormData(form).entries());
      data.websiteSlug = form.dataset.slug;

      const res = await fetch("/site-backend/reserve", {
        method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(data)
      });
      const result = await res.json();
      status.textContent = result.message;
      status.className = `booking-status text-sm text-center ${result.success ? "text-success" : "text-red-400"}`;
      if (result.success) form.reset();
    });
  });
</script>