<section class="px-6 py-16 max-w-6xl mx-auto">
  <h2 class="text-3xl font-bold text-center mb-10"><%= section.content.heading %></h2>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
    <% (section.content.items || []).forEach(item => { %>
      <div class="card-glass p-6">
        <h3 class="font-semibold mb-2"><%= item.title %></h3>
        <p class="text-muted text-sm"><%= item.description %></p>
      </div>
    <% }) %>
  </div>
</section>