<aside class="w-full lg:w-72 h-full bg-surface/60 border-l border-white/5 overflow-y-auto p-4 shrink-0" id="propertiesPanel">
  <div id="noSelection" class="text-muted text-sm text-center mt-10 px-4">
    <p class="text-3xl mb-3">🎯</p>
    <p>Tap a component in the canvas to edit its properties here.</p>
  </div>

  <div id="propertiesForm" class="hidden space-y-5 pb-8">
    <div>
      <p class="text-xs font-semibold text-muted uppercase mb-2">Content</p>
      <div id="contentFields" class="space-y-2"></div>
    </div>

    <div>
      <p class="text-xs font-semibold text-muted uppercase mb-2">Typography</p>
      <div class="grid grid-cols-2 gap-2">
        <select id="propFontFamily" class="input-field text-sm col-span-2"><option value="">Font Family</option><option>Inter</option><option>Space Grotesk</option><option>Georgia</option></select>
        <input id="propFontSize" type="text" class="input-field text-sm" placeholder="Font size" />
        <select id="propFontWeight" class="input-field text-sm"><option value="">Weight</option><option>400</option><option>500</option><option>600</option><option>700</option></select>
        <input id="propLineHeight" type="text" class="input-field text-sm" placeholder="Line height" />
        <input id="propLetterSpacing" type="text" class="input-field text-sm" placeholder="Letter spacing" />
        <select id="propTextAlign" class="input-field text-sm col-span-2"><option value="">Alignment</option><option>left</option><option>center</option><option>right</option></select>
      </div>
    </div>

    <div>
      <p class="text-xs font-semibold text-muted uppercase mb-2">Color</p>
      <div class="grid grid-cols-2 gap-2">
        <div>
          <label class="text-xs text-muted block mb-1">Text</label>
          <input id="propTextColor" type="color" class="w-full h-10 rounded-lg bg-transparent" />
        </div>
        <div>
          <label class="text-xs text-muted block mb-1">Background</label>
          <input id="propBgColor" type="color" class="w-full h-10 rounded-lg bg-transparent" />
        </div>
      </div>
    </div>

    <div>
      <p class="text-xs font-semibold text-muted uppercase mb-2">Spacing & Layout</p>
      <div class="grid grid-cols-2 gap-2">
        <input id="propWidth" type="text" class="input-field text-sm" placeholder="Width" />
        <input id="propHeight" type="text" class="input-field text-sm" placeholder="Height" />
        <input id="propMargin" type="text" class="input-field text-sm" placeholder="Margin" />
        <input id="propPadding" type="text" class="input-field text-sm" placeholder="Padding" />
      </div>
    </div>

    <div>
      <p class="text-xs font-semibold text-muted uppercase mb-2">Border & Shadow</p>
      <div class="grid grid-cols-2 gap-2">
        <input id="propRadius" type="text" class="input-field text-sm" placeholder="Border radius" />
        <input id="propShadow" type="text" class="input-field text-sm" placeholder="Shadow" />
      </div>
    </div>

    <button id="applyStylesBtn" class="btn-primary w-full text-sm sticky bottom-2">Apply Changes</button>

    <div class="pt-4 border-t border-white/10 space-y-2">
      <button id="duplicateBtn" class="btn-glass w-full text-sm">Duplicate</button>
      <button id="hideBtn" class="btn-glass w-full text-sm">Hide / Show</button>
      <button id="deleteBtn" class="btn-glass w-full text-sm text-red-400">Delete</button>
    </div>
  </div>
</aside>